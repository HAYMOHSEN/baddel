<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="App.Name">Baddel</sys:String>
    <sys:String x:Key="App.FullName">Baddel — Keyboard Language Fixer</sys:String>
    <sys:String x:Key="App.WindowTitle">Baddel</sys:String>
    <sys:String x:Key="App.Tagline">Fix text typed in the wrong keyboard language, in one keystroke</sys:String>
    <sys:String x:Key="Status.Running">Works in every app</sys:String>
    <sys:String x:Key="Status.Paused">Paused</sys:String>
    <sys:String x:Key="Status.NoShortcut">Shortcut not active</sys:String>
    <sys:String x:Key="Banner.ShortcutUnavailable">The shortcut couldn't be turned on because another app uses it. Choose a different shortcut so Baddel can work.</sys:String>
    <sys:String x:Key="Banner.ChangeShortcut">Change shortcut</sys:String>
    <sys:String x:Key="Tab.Convert">Converter</sys:String>
    <sys:String x:Key="Tab.Settings">Settings</sys:String>
    <sys:String x:Key="Tab.About">About</sys:String>
    <sys:String x:Key="Welcome.Title">Welcome to Baddel</sys:String>
    <sys:String x:Key="Welcome.Body">Type in any app as usual. When you notice you typed in the wrong language, select the text and press the shortcut. It's fixed instantly, and your keyboard switches language too.</sys:String>
    <sys:String x:Key="Welcome.Try">Try it now: select the text in the box, then press {0}</sys:String>
    <sys:String x:Key="Welcome.NoSelectionTip">You don't always need to select: with nothing selected, Baddel fixes the words you just typed on the line. Press the shortcut again to undo.</sys:String>
    <sys:String x:Key="Welcome.StartWithWindows">Start Baddel with Windows</sys:String>
    <sys:String x:Key="Welcome.Done">Start using Baddel</sys:String>
    <sys:String x:Key="Convert.Input">Original text</sys:String>
    <sys:String x:Key="Convert.InputHint">Paste text that was typed in the wrong language</sys:String>
    <sys:String x:Key="Convert.Output">Result</sys:String>
    <sys:String x:Key="Convert.Copy">Copy result</sys:String>
    <sys:String x:Key="Convert.Copied">Result copied</sys:String>
    <sys:String x:Key="Convert.Swap">Swap</sys:String>
    <sys:String x:Key="Convert.Clear">Clear</sys:String>
    <sys:String x:Key="Direction.Auto">Direction: automatic</sys:String>
    <sys:String x:Key="Direction.ToArabic">To Arabic</sys:String>
    <sys:String x:Key="Direction.ToLatin">To English</sys:String>
    <sys:String x:Key="Settings.Shortcut.Title">Fix shortcut</sys:String>
    <sys:String x:Key="Settings.Shortcut.Desc">Click the box, then press the keys you want to use.</sys:String>
    <sys:String x:Key="Settings.Shortcut.Reset">Default</sys:String>
    <sys:String x:Key="Settings.Shortcut.Recording">Press the new shortcut…</sys:String>
    <sys:String x:Key="Settings.Shortcut.Saved">Shortcut saved: {0}</sys:String>
    <sys:String x:Key="Settings.Shortcut.InUse">Another app uses this shortcut. Choose a different one.</sys:String>
    <sys:String x:Key="Settings.Shortcut.Invalid">Use Ctrl, Alt or Win with another key, or a single key such as F9 or Pause.</sys:String>
    <sys:String x:Key="Settings.Behavior.Title">When fixing</sys:String>
    <sys:String x:Key="Settings.SelectLine">If nothing is selected, fix the latest words on the current line</sys:String>
    <sys:String x:Key="Settings.SwitchLayout">Switch the keyboard language after fixing</sys:String>
    <sys:String x:Key="Settings.RestoreClipboard">Put the clipboard back the way it was after fixing</sys:String>
    <sys:String x:Key="Settings.ShowNotifications">Show a small notification after each fix</sys:String>
    <sys:String x:Key="Settings.General.Title">General</sys:String>
    <sys:String x:Key="Settings.StartWithWindows">Start Baddel when Windows starts</sys:String>
    <sys:String x:Key="Settings.Startup.DisabledByUser">Startup is turned off in Windows. Turn it on in Settings &gt; Apps &gt; Startup.</sys:String>
    <sys:String x:Key="Settings.Startup.DisabledByPolicy">Startup is turned off by your administrator.</sys:String>
    <sys:String x:Key="Settings.Startup.Unavailable">The startup setting couldn't be reached.</sys:String>
    <sys:String x:Key="Settings.Language">Interface language</sys:String>
    <sys:String x:Key="Settings.Theme">Theme</sys:String>
    <sys:String x:Key="Theme.System">Use Windows setting</sys:String>
    <sys:String x:Key="Theme.Light">Light</sys:String>
    <sys:String x:Key="Theme.Dark">Dark</sys:String>
    <sys:String x:Key="Settings.Layouts.Title">Keyboard layouts</sys:String>
    <sys:String x:Key="Settings.Layouts.Desc">Baddel detects the layouts installed on your PC. Change these only if you have more than one Arabic or Latin layout.</sys:String>
    <sys:String x:Key="Settings.Layouts.Arabic">Arabic layout</sys:String>
    <sys:String x:Key="Settings.Layouts.Latin">Latin layout</sys:String>
    <sys:String x:Key="Settings.Layouts.Auto">Automatic</sys:String>
    <sys:String x:Key="Settings.Layouts.Missing">No Arabic layout is installed, so the standard Arabic (101) layout is used. Add Arabic in Windows Settings &gt; Time and language.</sys:String>
    <sys:String x:Key="About.Version">Version {0}</sys:String>
    <sys:String x:Key="About.Developer">Developed by {0}</sys:String>
    <sys:String x:Key="About.Privacy.Title">Your privacy</sys:String>
    <sys:String x:Key="About.Privacy.Body">Baddel doesn't monitor what you type and only acts when you press the shortcut. Everything is processed on your PC; no text is ever sent online.</sys:String>
    <sys:String x:Key="About.Help.Title">How to use</sys:String>
    <sys:String x:Key="About.Help.Body">Select text typed in the wrong language and press the shortcut. With nothing selected, Baddel fixes the words you just typed on the line. Press the shortcut again on the same text to undo. You can also fix copied text from the Baddel icon next to the clock.</sys:String>
    <sys:String x:Key="About.Rate">Rate Baddel in the Store</sys:String>
    <sys:String x:Key="About.Support">Email support</sys:String>
    <sys:String x:Key="About.PrivacyLink">Privacy policy</sys:String>
    <sys:String x:Key="About.Notices">Third-party notices</sys:String>
    <sys:String x:Key="Tray.Open">Open Baddel</sys:String>
    <sys:String x:Key="Tray.FixClipboard">Fix copied text</sys:String>
    <sys:String x:Key="Tray.Pause">Pause</sys:String>
    <sys:String x:Key="Tray.Resume">Resume</sys:String>
    <sys:String x:Key="Tray.Settings">Settings</sys:String>
    <sys:String x:Key="Tray.Exit">Exit</sys:String>
    <sys:String x:Key="Tray.Tooltip">Baddel — {0}</sys:String>
    <sys:String x:Key="Tray.TooltipPaused">Baddel — paused</sys:String>
    <sys:String x:Key="Tray.StillRunning.Title">Baddel is still running</sys:String>
    <sys:String x:Key="Tray.StillRunning.Body">Press {0} to fix text in any app. You'll find Baddel next to the clock.</sys:String>
    <sys:String x:Key="Osd.ToArabic">Fixed to Arabic</sys:String>
    <sys:String x:Key="Osd.ToLatin">Fixed to English</sys:String>
    <sys:String x:Key="Osd.Reverted">Original text restored</sys:String>
    <sys:String x:Key="Osd.NothingSelected">Select the text first, then press the shortcut</sys:String>
    <sys:String x:Key="Osd.NothingToConvert">Nothing here needs fixing</sys:String>
    <sys:String x:Key="Osd.Elevated">Baddel can't work inside an app running as administrator</sys:String>
    <sys:String x:Key="Osd.Terminal">Fixing isn't available in terminal windows</sys:String>
    <sys:String x:Key="Osd.Failed">Couldn't fix the text. Try again</sys:String>
    <sys:String x:Key="Osd.ClipboardFixed">Copied text fixed. Paste it where you need it</sys:String>
    <sys:String x:Key="Osd.ClipboardEmpty">There's no copied text</sys:String>
    <sys:String x:Key="Rate.Title">Enjoying Baddel?</sys:String>
    <sys:String x:Key="Rate.Body">Texts fixed so far: {0}. Click here to rate Baddel in the Store.</sys:String>
</ResourceDictionary>
