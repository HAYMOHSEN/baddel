<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="App.Name">بدّل</sys:String>
    <sys:String x:Key="App.FullName">بدّل — مصحّح لغة الكتابة</sys:String>
    <sys:String x:Key="App.WindowTitle">بدّل</sys:String>
    <sys:String x:Key="App.Tagline">صحّح ما كتبته بلغة لوحة المفاتيح الخطأ، بضغطة واحدة</sys:String>
    <sys:String x:Key="Status.Running">يعمل في كل البرامج</sys:String>
    <sys:String x:Key="Status.Paused">متوقف مؤقتًا</sys:String>
    <sys:String x:Key="Status.NoShortcut">الاختصار غير مفعّل</sys:String>
    <sys:String x:Key="Banner.ShortcutUnavailable">تعذّر تفعيل الاختصار لأن برنامجًا آخر يستخدمه. اختر اختصارًا آخر ليعمل بدّل.</sys:String>
    <sys:String x:Key="Banner.ChangeShortcut">تغيير الاختصار</sys:String>
    <sys:String x:Key="Tab.Convert">المحوّل</sys:String>
    <sys:String x:Key="Tab.Settings">الإعدادات</sys:String>
    <sys:String x:Key="Tab.About">حول</sys:String>
    <sys:String x:Key="Welcome.Title">أهلًا بك في بدّل</sys:String>
    <sys:String x:Key="Welcome.Body">اكتب في أي برنامج كالمعتاد. إذا اكتشفت أنك كتبت بلغة خاطئة، حدّد النص واضغط الاختصار، فيُصحَّح فورًا وتتبدّل لغة لوحة المفاتيح معه.</sys:String>
    <sys:String x:Key="Welcome.Try">جرّبه الآن: حدّد النص في المربع ثم اضغط {0}</sys:String>
    <sys:String x:Key="Welcome.NoSelectionTip">لا يلزم التحديد دائمًا: إذا لم تحدد شيئًا، يصحّح بدّل آخر ما كتبته في السطر. واضغط الاختصار مرة أخرى للتراجع.</sys:String>
    <sys:String x:Key="Welcome.StartWithWindows">شغّل بدّل تلقائيًا مع ويندوز</sys:String>
    <sys:String x:Key="Welcome.Done">ابدأ الاستخدام</sys:String>
    <sys:String x:Key="Convert.Input">النص الأصلي</sys:String>
    <sys:String x:Key="Convert.InputHint">الصق هنا نصًا كُتب بلغة خاطئة</sys:String>
    <sys:String x:Key="Convert.Output">النتيجة</sys:String>
    <sys:String x:Key="Convert.Copy">نسخ النتيجة</sys:String>
    <sys:String x:Key="Convert.Copied">نُسخت النتيجة</sys:String>
    <sys:String x:Key="Convert.Swap">تبديل</sys:String>
    <sys:String x:Key="Convert.Clear">مسح</sys:String>
    <sys:String x:Key="Direction.Auto">الاتجاه: تلقائي</sys:String>
    <sys:String x:Key="Direction.ToArabic">إلى العربية</sys:String>
    <sys:String x:Key="Direction.ToLatin">إلى الإنجليزية</sys:String>
    <sys:String x:Key="Settings.Shortcut.Title">اختصار التصحيح</sys:String>
    <sys:String x:Key="Settings.Shortcut.Desc">انقر على المربع ثم اضغط المفاتيح التي تريدها.</sys:String>
    <sys:String x:Key="Settings.Shortcut.Reset">الافتراضي</sys:String>
    <sys:String x:Key="Settings.Shortcut.Recording">اضغط الاختصار الجديد…</sys:String>
    <sys:String x:Key="Settings.Shortcut.Saved">حُفظ الاختصار: {0}</sys:String>
    <sys:String x:Key="Settings.Shortcut.InUse">يستخدم برنامج آخر هذا الاختصار. اختر اختصارًا مختلفًا.</sys:String>
    <sys:String x:Key="Settings.Shortcut.Invalid">استخدم Ctrl أو Alt أو Win مع مفتاح آخر، أو مفتاحًا منفردًا مثل F9 أو Pause.</sys:String>
    <sys:String x:Key="Settings.Behavior.Title">عند التصحيح</sys:String>
    <sys:String x:Key="Settings.SelectLine">إذا لم يكن هناك نص محدد، صحّح آخر ما كُتب في السطر الحالي</sys:String>
    <sys:String x:Key="Settings.SwitchLayout">بدّل لغة لوحة المفاتيح تلقائيًا بعد التصحيح</sys:String>
    <sys:String x:Key="Settings.RestoreClipboard">أعِد محتوى الحافظة كما كان بعد التصحيح</sys:String>
    <sys:String x:Key="Settings.ShowNotifications">أظهر إشعارًا صغيرًا بعد كل تصحيح</sys:String>
    <sys:String x:Key="Settings.General.Title">عام</sys:String>
    <sys:String x:Key="Settings.StartWithWindows">شغّل بدّل مع بدء تشغيل ويندوز</sys:String>
    <sys:String x:Key="Settings.Startup.DisabledByUser">التشغيل التلقائي معطّل من ويندوز. فعّله من: الإعدادات ← التطبيقات ← بدء التشغيل.</sys:String>
    <sys:String x:Key="Settings.Startup.DisabledByPolicy">التشغيل التلقائي معطّل بسياسة من مسؤول الجهاز.</sys:String>
    <sys:String x:Key="Settings.Startup.Unavailable">تعذّر الوصول إلى إعداد التشغيل التلقائي.</sys:String>
    <sys:String x:Key="Settings.Language">لغة الواجهة</sys:String>
    <sys:String x:Key="Settings.Theme">المظهر</sys:String>
    <sys:String x:Key="Theme.System">حسب ويندوز</sys:String>
    <sys:String x:Key="Theme.Light">فاتح</sys:String>
    <sys:String x:Key="Theme.Dark">داكن</sys:String>
    <sys:String x:Key="Settings.Layouts.Title">تخطيطات لوحة المفاتيح</sys:String>
    <sys:String x:Key="Settings.Layouts.Desc">يتعرّف بدّل تلقائيًا على التخطيطات المثبّتة على جهازك. غيّر الاختيار فقط إذا كان لديك أكثر من تخطيط عربي أو لاتيني.</sys:String>
    <sys:String x:Key="Settings.Layouts.Arabic">التخطيط العربي</sys:String>
    <sys:String x:Key="Settings.Layouts.Latin">التخطيط اللاتيني</sys:String>
    <sys:String x:Key="Settings.Layouts.Auto">تلقائي</sys:String>
    <sys:String x:Key="Settings.Layouts.Missing">لا يوجد تخطيط عربي مثبّت، فيُستخدم التخطيط العربي القياسي (101). أضف العربية من إعدادات ويندوز ← الوقت واللغة.</sys:String>
    <sys:String x:Key="About.Version">الإصدار {0}</sys:String>
    <sys:String x:Key="About.Developer">تطوير {0}</sys:String>
    <sys:String x:Key="About.Privacy.Title">خصوصيتك</sys:String>
    <sys:String x:Key="About.Privacy.Body">لا يراقب بدّل ما تكتبه، ولا يعمل إلا عندما تضغط الاختصار. تتم المعالجة كلها على جهازك، ولا يُرسَل أي نص إلى الإنترنت.</sys:String>
    <sys:String x:Key="About.Help.Title">طريقة الاستخدام</sys:String>
    <sys:String x:Key="About.Help.Body">حدّد النص المكتوب بلغة خاطئة واضغط الاختصار. إن لم تحدد شيئًا، يصحّح بدّل آخر ما كتبته في السطر. اضغط الاختصار مرة أخرى على النص نفسه للتراجع. ويمكنك تصحيح نص منسوخ من أيقونة بدّل بجوار الساعة.</sys:String>
    <sys:String x:Key="About.Rate">قيّم بدّل في المتجر</sys:String>
    <sys:String x:Key="About.Support">راسل الدعم الفني</sys:String>
    <sys:String x:Key="About.PrivacyLink">سياسة الخصوصية</sys:String>
    <sys:String x:Key="About.Notices">تراخيص المكونات</sys:String>
    <sys:String x:Key="Tray.Open">فتح بدّل</sys:String>
    <sys:String x:Key="Tray.FixClipboard">صحّح النص المنسوخ</sys:String>
    <sys:String x:Key="Tray.Pause">إيقاف مؤقت</sys:String>
    <sys:String x:Key="Tray.Resume">استئناف</sys:String>
    <sys:String x:Key="Tray.Settings">الإعدادات</sys:String>
    <sys:String x:Key="Tray.Exit">خروج</sys:String>
    <sys:String x:Key="Tray.Tooltip">بدّل — {0}</sys:String>
    <sys:String x:Key="Tray.TooltipPaused">بدّل — متوقف مؤقتًا</sys:String>
    <sys:String x:Key="Tray.StillRunning.Title">بدّل يعمل في الخلفية</sys:String>
    <sys:String x:Key="Tray.StillRunning.Body">اضغط {0} لتصحيح النص في أي برنامج. تجد بدّل بجوار الساعة.</sys:String>
    <sys:String x:Key="Osd.ToArabic">صُحّح إلى العربية</sys:String>
    <sys:String x:Key="Osd.ToLatin">صُحّح إلى الإنجليزية</sys:String>
    <sys:String x:Key="Osd.Reverted">أُعيد النص الأصلي</sys:String>
    <sys:String x:Key="Osd.NothingSelected">حدّد النص أولًا، ثم اضغط الاختصار</sys:String>
    <sys:String x:Key="Osd.NothingToConvert">لا يوجد في النص ما يحتاج إلى تصحيح</sys:String>
    <sys:String x:Key="Osd.Elevated">لا يستطيع بدّل العمل داخل برنامج يعمل بصلاحيات المسؤول</sys:String>
    <sys:String x:Key="Osd.Terminal">التصحيح غير متاح في نوافذ الأوامر</sys:String>
    <sys:String x:Key="Osd.Failed">تعذّر التصحيح. حاول مرة أخرى</sys:String>
    <sys:String x:Key="Osd.ClipboardFixed">صُحّح النص المنسوخ، الصقه حيث تريد</sys:String>
    <sys:String x:Key="Osd.ClipboardEmpty">لا يوجد نص منسوخ</sys:String>
    <sys:String x:Key="Rate.Title">هل أعجبك بدّل؟</sys:String>
    <sys:String x:Key="Rate.Body">عدد النصوص التي صحّحتها حتى الآن: {0}. انقر هنا لتقييم بدّل في المتجر.</sys:String>
</ResourceDictionary>
