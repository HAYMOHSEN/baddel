<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand: saffron keycap on ink -->
    <SolidColorBrush x:Key="Baddel.Saffron" Color="#E9A23B" />
    <SolidColorBrush x:Key="Baddel.Ink" Color="#1E2532" />

    <!-- Theme-dependent; ThemeService replaces these at run time -->
    <SolidColorBrush x:Key="Baddel.CardBackground" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="Baddel.CardBorder" Color="#14000000" />
    <SolidColorBrush x:Key="Baddel.TextSecondary" Color="#9E000000" />
    <SolidColorBrush x:Key="Baddel.KeycapFace" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Baddel.KeycapEdge" Color="#C3C9D4" />
    <SolidColorBrush x:Key="Baddel.Success" Color="#0F7B0F" />
    <SolidColorBrush x:Key="Baddel.Caution" Color="#9D5D00" />
    <SolidColorBrush x:Key="Baddel.WarningBackground" Color="#FFF4CE" />

    <Style x:Key="Baddel.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Baddel.CardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Baddel.CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20,16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="Baddel.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Baddel.Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource Baddel.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- A key on a keyboard: the shortcut is always shown this way -->
    <Style x:Key="Baddel.Keycap" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Baddel.KeycapFace}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Baddel.KeycapEdge}" />
        <Setter Property="BorderThickness" Value="1,1,1,3" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="11,4,11,3" />
        <Setter Property="Margin" Value="3,0" />
        <Setter Property="MinWidth" Value="36" />
    </Style>

    <Style x:Key="Baddel.KeycapText" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
