<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Baddel</AssemblyName>
    <RootNamespace>Baddel</RootNamespace>
    <ApplicationIcon>Assets\Baddel.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Baddel</Product>
    <Company>Hani Muhsen</Company>
    <Copyright>© 2026 Prof. Hani Muhsen</Copyright>
    <Description>Fixes text typed in the wrong keyboard language (Arabic and English).</Description>
    <SatelliteResourceLanguages>ar;en</SatelliteResourceLanguages>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- WPF's Fluent theme (ThemeMode) is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <!-- The Store package carries its own .NET runtime, so users don't need to install anything. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Baddel.Core\Baddel.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Baddel.ico" />
    <Resource Include="Assets\Logo.png" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
